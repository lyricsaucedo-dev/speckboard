# Speckboard environment variables
# Copy to .env and fill in your Stripe keys from https://dashboard.stripe.com/apikeys

# Server
PORT=3001
# Same-origin in production: https://your-app.onrender.com (or Railway URL)
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: override JSON store directory (Render/Railway volume: /data)
# DATA_DIR=/data

# Stripe (required for real payments — app runs in demo mode without them)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Force demo purchases even if Stripe keys exist
# DEMO_CHECKOUT=true

# Persistence: JSON file at data/speckboard.json (or $DATA_DIR/speckboard.json)
# On ephemeral hosts, mount a persistent volume or sold pixels will be lost on redeploy.
