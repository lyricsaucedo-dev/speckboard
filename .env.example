# Speckboard environment variables
# Copy to .env:  copy .env.example .env
# Get test keys: https://dashboard.stripe.com/test/apikeys
# (toggle "Test mode" ON in the Stripe Dashboard)

# Server
PORT=3001
# Local Vite origin (CORS + Stripe success/cancel redirects)
CLIENT_URL=http://localhost:5173
# Production: set to your public HTTPS URL (same origin as the web service)
# CLIENT_URL=https://your-app.onrender.com
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: override JSON store directory (Render/Railway volume: /data)
# DATA_DIR=/data

# Stripe — replace placeholders with real test keys (no ellipsis / REPLACE_ME).
# Accepts sk_test_… or restricted sandbox keys (rkcs_test_… / rk_test_…).
# If secret is still a template, the API stays in demo mode.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Local: run `stripe listen --print-secret` (and `stripe listen --forward-to localhost:3001/api/stripe/webhook`)
# and paste the whsec_… into STRIPE_WEBHOOK_SECRET.
# Render: create a Dashboard webhook endpoint (see README) and paste its secret.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Force demo purchases even if Stripe keys exist (leave unset for real Checkout)
# DEMO_CHECKOUT=true

# Persistence: JSON file at data/speckboard.json (or $DATA_DIR/speckboard.json)
# On ephemeral hosts, mount a persistent volume or sold pixels will be lost on redeploy.
